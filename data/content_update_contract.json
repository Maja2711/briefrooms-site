{
  "contract_version": "3.0.0",
  "news_publication": {
    "workflow": ".github/workflows/publish-news.yml",
    "workflow_name": "Publish PL and EN News",
    "required_cron": "17 * * * *",
    "interval_hours": 1,
    "languages": [
      "pl",
      "en"
    ],
    "manifest": "data/news/status.json",
    "language_feeds": {
      "pl": "data/news/pl.json",
      "en": "data/news/en.json"
    },
    "atomic_languages_required": true,
    "live_runtime": "scripts/news-live.js",
    "browser_refresh_minutes": 15,
    "last_good_fallback_required": true,
    "maximum_carried_story_age_days": 14,
    "empty_update_may_refresh_content_timestamps": false,
    "production_marker_required": true
  },
  "watchdog": {
    "workflow": ".github/workflows/automation-health-audit.yml",
    "check_interval_hours": 1,
    "successful_publication_stale_after_hours": 2,
    "production_main_parity_required": true,
    "single_open_alarm_issue": true
  },
  "hot_x": {
    "workflow": ".github/workflows/hot-x-topics.yml",
    "interval_hours": 12,
    "required_cron": "17 6,18 * * *",
    "data_only_publication": true
  }
}
