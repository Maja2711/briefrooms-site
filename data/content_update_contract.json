{
  "contract_version": "2.0.0",
  "news_publication": {
    "workflow": ".github/workflows/publish-news.yml",
    "required_cron": "15 */4 * * *",
    "interval_hours": 4,
    "languages": [
      "pl",
      "en"
    ],
    "manifest": "data/news_publication_status.json",
    "source_report": "data/news_source_report.json",
    "atomic_languages_required": true,
    "last_good_fallback_required": true,
    "empty_update_may_refresh_content_timestamps": false
  },
  "watchdog": {
    "workflow": ".github/workflows/content-update-watchdog.yml",
    "check_interval_hours": 1,
    "successful_fetch_stale_after_hours": 8,
    "successful_publication_stale_after_hours": 8,
    "new_publication_stale_after_hours": 24,
    "production_main_parity_required": true,
    "automatic_recovery_after_hours": 8,
    "single_open_alarm_issue": true
  },
  "hot_x": {
    "workflow": ".github/workflows/hot-x-topics.yml",
    "interval_hours": 12,
    "required_cron": "17 6,18 * * *",
    "data_only_publication": true
  }
}
