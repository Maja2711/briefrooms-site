{
  "schema_version": "brace-portfolio-learning-envelope-v1",
  "engine_id": "brace_portfolio_10k",
  "base_currency": "PLN",
  "prospective_only": true,
  "historical_backfill": false,
  "real_broker_integration": false,
  "trade_execution_authority": false,
  "learner_may_expand_envelope": false,
  "supported_fx_pairs": {
    "USD": "USDPLN",
    "EUR": "EURPLN"
  },
  "fx_hedge": {
    "allowed_ratios": [0.0, 0.25, 0.5, 0.75, 1.0],
    "maximum_ratio": 1.0,
    "minimum_notional_pln": 250.0,
    "estimated_round_trip_cost_bps": 8.0,
    "promotion_step_limit": 0.25
  },
  "options_hedge": {
    "enabled_if_market_data_available": true,
    "allowed_strategies": ["PROTECTIVE_PUT", "PUT_SPREAD", "COLLAR"],
    "naked_short_options": false,
    "minimum_dte": 20,
    "maximum_dte": 90,
    "maximum_relative_bid_ask_spread": 0.20,
    "minimum_bid": 0.01,
    "maximum_single_premium_fraction_nav": 0.005,
    "maximum_annual_premium_fraction_nav": 0.015,
    "maximum_covered_call_notional_fraction": 1.0
  },
  "utility": {
    "return_weight": 1.0,
    "drawdown_penalty": 0.50,
    "cvar_penalty": 0.25,
    "turnover_penalty": 0.10,
    "transaction_cost_penalty": 1.0,
    "concentration_penalty": 0.10
  },
  "validation": {
    "fx_minimum_resolved_observations": 30,
    "options_minimum_resolved_observations": 20,
    "minimum_independent_regimes": 2,
    "required_consecutive_confirmations": 2,
    "confidence_level": 0.95,
    "minimum_ci_lower_bound_utility": 0.0,
    "minimum_mean_utility_improvement": 0.001,
    "minimum_rollback_observations": 15,
    "rollback_mean_utility_threshold": -0.002
  },
  "promotion": {
    "automatic_when_validation_passes": true,
    "manual_approval_required": false,
    "maximum_one_policy_change_per_validation_epoch": true,
    "production_writeback_scope": ["fx_hedge_ratio_by_regime", "options_strategy_by_regime"],
    "forbidden_writeback": ["max_single_stock_weight", "max_broad_etf_weight", "max_sector_weight", "max_currency_weight", "max_region_weight", "max_expected_drawdown", "emergency_drawdown", "max_annual_turnover", "real_broker_integration_enabled", "autonomy_mode"]
  }
}
