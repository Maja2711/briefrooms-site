{
  "schema_version": "briefrooms-trading-notifications-config-v1",
  "access_mode": "PUBLIC",
  "channel_access": {
    "daily": "PUBLIC",
    "weekly": "PUBLIC",
    "stock": "PUBLIC"
  },
  "event_types": {
    "open": true,
    "close": true
  },
  "poll_interval_seconds": 60,
  "background_push": {
    "enabled": true,
    "api_base": "https://briefrooms-trading-push.szczerbinski0577.workers.dev",
    "provider": "cloudflare_worker"
  },
  "analytics": {
    "enabled": true,
    "api_base": "https://briefrooms-trading-push.szczerbinski0577.workers.dev"
  }
}
