{
  "policy_version": "5.3.0",
  "name": "BriefRooms continuous multi-instrument weekly paper exposure",
  "status": "experimental_paper_trading_only",
  "enabled": true,
  "mandatory_monday_position": true,
  "continuous_position_required": true,
  "monday_open_not_before_local": "08:00",
  "scheduled_friday_close_local": "22:00",
  "reentry_after_any_close": true,
  "minimum_minutes_after_exit": 5,
  "max_simultaneous_positions_per_instrument": 1,
  "instruments": [
    {"instrument_id": "eurusd", "enabled": true, "round_trip_cost": 1.5, "cost_unit": "pips", "default_tie_direction": "long"},
    {"instrument_id": "sp500_futures", "enabled": true, "round_trip_cost": 1.0, "cost_unit": "points", "default_tie_direction": "long"},
    {"instrument_id": "btcusd", "enabled": true, "round_trip_cost": 0.2, "cost_unit": "percent", "default_tie_direction": "long"}
  ],
  "strategy_tournament": {
    "enabled": true,
    "candidate_methods": ["base_v2", "inverse_v2", "weekly_trend", "daily_weekly_blend", "ema_mean_reversion", "macro_weekly_blend"],
    "rolling_closed_legs": 120,
    "minimum_observations_before_performance_weight": 6,
    "prior_observations": 5,
    "performance_weight": 18.0,
    "exploration_bonus": 2.5,
    "maximum_learning_adjustment": 18.0,
    "rule": "Select the highest-utility directional candidate for every enabled instrument using only earlier closed paper legs. EUR/USD candidates also receive a bounded oil and US10Y alignment adjustment."
  },
  "contextual_learning": {
    "enabled": true,
    "scope": ["eurusd"],
    "tracked_contexts": ["against_aligned_up_momentum", "against_aligned_down_momentum"],
    "momentum_inputs": ["ret5_pct", "ret20_pct"],
    "minimum_absolute_momentum_pct": 0.15,
    "minimum_observations_before_adjustment": 6,
    "prior_observations": 5,
    "performance_weight": 18.0,
    "maximum_adjustment": 10.0,
    "apply_to_methods": ["ema_mean_reversion"],
    "rule": "Track mean-reversion performance separately when the candidate direction opposes aligned 5-day and 20-day momentum. Do not change utility until at least six earlier closed paper legs exist in the same context; then apply a shrunk bounded adjustment. A single loss must never change weights by itself."
  },
  "weekly_candle_model": {
    "enabled": true,
    "minimum_weekly_bars": 40,
    "ema_fast": 10,
    "ema_slow": 30,
    "momentum_fast_weeks": 4,
    "momentum_slow_weeks": 13,
    "breakout_lookback_weeks": 26,
    "weights": {"trend": 35, "momentum_fast": 25, "momentum_slow": 20, "breakout": 15, "last_candle": 5}
  },
  "macro_context": {
    "enabled": true,
    "applies_to": ["eurusd"],
    "oil_symbol": "CL=F",
    "us10y_symbol": "^TNX",
    "require_both_sources": true,
    "score_cap": 30.0,
    "candidate_alignment_bonus_max": 6.0,
    "weights": {"oil_1w": 10.0, "oil_4w": 5.0, "us10y_1w": 10.0, "us10y_4w": 5.0},
    "normalization": {"oil_1w_percent": 8.0, "oil_4w_percent": 20.0, "us10y_1w_bps": 20.0, "us10y_4w_bps": 50.0},
    "blend_weights": {"daily": 0.35, "weekly": 0.40, "macro": 0.25},
    "daily_review_weights": {"daily": 0.50, "weekly": 0.35, "macro": 0.15},
    "daily_exit_combined_threshold": 22.0,
    "macro_confirmation_threshold": 18.0,
    "interpretation": "Falling oil and falling US10Y support EUR/USD; rising oil and rising US10Y support the dollar. Inputs are normalized, capped and never used as standalone trade triggers.",
    "rule": "The open position is not rewritten retroactively. Macro context enters new decisions and the governed 23:00 daily review."
  },
  "no_trade": {
    "enabled": false,
    "minimum_directional_raw_score": 0.0,
    "minimum_directional_utility": 0.0,
    "conflict_no_trade_below_raw_score": 0.0,
    "block_on_data_quality_failure": false,
    "fallback_direction_rule": "Use the enabled instrument default_tie_direction when directional candidates are tied or incomplete.",
    "rule": "NO_TRADE is disabled for enabled instruments; every instrument must hold LONG or SHORT paper exposure."
  },
  "execution_integrity": {
    "entry_decision_must_precede_entry": true,
    "first_completed_5m_bar_after_decision": true,
    "no_historical_backfill": true,
    "rule": "Every entry timestamp must be on or after the immutable decision timestamp."
  },
  "reentry_policy": {
    "after_stop_loss": true,
    "after_take_profit": true,
    "after_strategy_switch": true,
    "after_thesis_invalidation": true,
    "after_material_event_exit": true,
    "block_scope": "minimum_minutes_after_exit"
  },
  "daily_analysis": {
    "enabled": true,
    "review_after_local_hour": 23,
    "write_on_entry_or_reentry": true,
    "max_saved_reviews_per_instrument": 30,
    "show_latest_review_on_public_page": true
  },
  "learning_guardrails": {
    "use_only_closed_earlier_paper_legs": true,
    "no_future_data": true,
    "no_rewrite_of_closed_history": true,
    "no_guaranteed_profit_claims": true,
    "do_not_increase_notional_after_losses": true,
    "real_broker_orders": false,
    "paper_trading_only": true
  }
}
