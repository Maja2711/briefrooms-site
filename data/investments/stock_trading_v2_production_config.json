{
  "schema_version": "stock-trading-v2-production-config-v1",
  "enabled": true,
  "champion_engine": "v2",
  "challenger_engine": "v1",
  "initial_phase": "CANARY",
  "canary_max_open_positions_per_market": 1,
  "full_max_open_positions_per_market": 3,
  "auto_promote_canary": true,
  "healthy_market_sessions_required": 2,
  "require_both_markets_before_full": true,
  "maximum_opportunity_age_minutes": 360,
  "maximum_execution_quote_age_minutes": 5,
  "minimum_reward_risk": 1.5,
  "maximum_risk_percent": 0.07,
  "require_regular_session_for_new_entry": true,
  "candidate_search_policy": "continue_ranked_candidates_until_capacity_or_exhaustion",
  "cash_policy": "cash_competes_with_every_eligible_candidate_not_only_rank_1",
  "v1_shadow_policy": "continuous_session_no_arbitrary_cutoff_and_continue_after_rejection",
  "execution_quote_policy": "fresh_observed_quote_only_no_research_price_fill",
  "stale_execution_quote_policy": "READY_WAIT_FOR_FRESH_QUOTE",
  "healthy_sessions_per_market_required": 1,
  "full_cycle_max_new_positions_per_market": 3
}
