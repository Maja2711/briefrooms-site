{
  "schema_version": "stock-trading-v2-fundamentals-config-v1",
  "version": "1.0.0",
  "mode": "shadow_no_production_influence",
  "candidates_per_cycle": 10,
  "provider": "SEC_EDGAR_COMPANYFACTS",
  "sec_user_agent": "BriefRooms Stock Trading research contact@briefrooms.com",
  "spacing_seconds": 0.55,
  "cache_policy": "one_companyfacts_request_per_candidate_per_research_cycle",
  "accounting_policy": {
    "report_forms": [
      "10-K",
      "10-K/A",
      "10-Q",
      "10-Q/A"
    ],
    "period": "fiscal_year",
    "same_day_filing": "exclude_due_to_missing_acceptance_time",
    "missing_data": "null_no_imputation",
    "pe": "indicative_FY_only_not_split_adjusted",
    "annual_score": "10-K/10-K-A full fiscal year only",
    "quarterly_observations": "direct 65-115 day 10-Q/10-Q-A facts, no YTD-to-quarter inference"
  },
  "markets": {
    "US": {
      "structured_fundamentals": true
    },
    "GPW": {
      "structured_fundamentals": false,
      "reason": "requires_separate official GPW ESEF/XBRL ingestion"
    }
  },
  "governance": {
    "production_decision_influence": false,
    "automatic_portfolio_admission": false,
    "llm_calls": 0,
    "automatic_llm_inference": false,
    "requires_prospective_validation_before_scoring_authority": true
  }
}
